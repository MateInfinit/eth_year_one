*.pdb.meta
*.mdb.meta

# VS Code: keep shared settings, ignore the rest
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Crash reports / builds
sysinfo.txt
crashlytics-build.properties
*.apk
*.aab
*.unitypackage
*.app

# OS
.DS_Store
Thumbs.db

# Secrets
.env
